{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "finding_ids",
    "status",
    "changed_paths",
    "summary",
    "block_reason"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "finding_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "type": "string",
      "enum": ["FIXED", "BLOCKED"]
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "block_reason": {
      "type": ["string", "null"]
    }
  }
}
