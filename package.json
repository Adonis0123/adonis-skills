{
  "name": "adonis-skills",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@adonis-skills/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "docs:clean": "node --experimental-strip-types ./scripts/clean-docs.ts",
    "precommit:typecheck": "pnpm typecheck",
    "prepare": "simple-git-hooks",
    "skills:new": "node --experimental-strip-types ./scripts/create-skill.ts",
    "skills:finalize": "node --experimental-strip-types ./scripts/finalize-skill.ts",
    "skills:finalize:new": "node --experimental-strip-types ./scripts/finalize-new-skills.ts",
    "skills:finalize:new:test": "node --experimental-strip-types --test ./scripts/__tests__/finalize-new-skills.test.ts",
    "skills:init": "python3 ./.agents/skills/repo-skill-creator/scripts/init_skill.py",
    "skills:quick-validate": "python3 ./.agents/skills/repo-skill-creator/scripts/quick_validate.py",
    "skills:openai-yaml": "python3 ./.agents/skills/repo-skill-creator/scripts/generate_openai_yaml.py",
    "skills:index": "turbo run skills:index --filter=@adonis-skills/web",
    "skills:validate": "turbo run skills:validate --filter=@adonis-skills/web",
    "skills:install:local": "node --experimental-strip-types ./scripts/install-local-skills.ts",
    "skills:test:local": "node --experimental-strip-types ./scripts/install-local-skills.ts --sync-llm",
    "skills:eval-grade": "node ./scripts/grade-skill-evals.mjs",
    "test:web-offline-font-build": "node --test ./scripts/__tests__/web-offline-font-build.test.mjs",
    "brand:sync": "node scripts/sync-brand-tokens.mjs --from \"${BRAND_REPO:-../adonis-brand}\"",
    "brand:check": "node scripts/sync-brand-tokens.mjs --check",
    "design:check": "node scripts/check-design-tokens.mjs",
    "test:scripts": "node --experimental-strip-types --test --test-concurrency=2 ./scripts/__tests__/ardot-mcp-public.test.ts ./scripts/__tests__/chrome-dev-mcp-public.test.ts ./scripts/__tests__/uxc-facade-public.test.ts ./scripts/__tests__/finalize-new-skills.test.ts ./scripts/__tests__/finalize-skill.test.ts ./scripts/__tests__/install-local-skills.test.ts ./scripts/__tests__/workflow-gate-public.test.ts ./scripts/__tests__/grade-skill-evals.test.mjs ./scripts/__tests__/brand-tokens.test.mjs ./scripts/__tests__/check-design-tokens.test.mjs ./scripts/__tests__/generate-skills-index-sections.test.mjs",
    "design:lint": "designmd lint DESIGN.md",
    "precommit:skills": "node scripts/precommit-skills.mjs"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@inquirer/prompts": "^7.9.0",
    "is-ci": "^4.1.0",
    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.7.6",
    "yaml": "^2.8.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm precommit:skills && pnpm precommit:typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,jsx,json,css,md}": "prettier --write --end-of-line lf"
  }
}
